NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=local-development-secret-change-me-12345
JWT_ACCESS_TTL=3600
REFRESH_TOKEN_TTL=2592000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google
# Leave empty locally to print verification codes in the API log.
RESEND_API_KEY=
MAIL_FROM=Vedora <onboarding@resend.dev>
# Mux video uploads (https://dashboard.mux.com → Settings → Access Tokens).
# Leave empty to disable uploads (503).
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Signing secret of the webhook pointing at <api>/api/v1/webhooks/mux. Leave
# empty locally: the API then asks Mux for upload status when it's polled.
MUX_WEBHOOK_SECRET=
# Caption published videos with Mux Robots (Vietnamese <-> English). Billed per
# minute of video beyond Mux's free Robots units; needs the webhook above.
MUX_CAPTIONS_ENABLED=false
# OpenRouter (https://openrouter.ai/settings/keys) runs the nutrition assistant
# and the knowledge base; required. Any OpenRouter model id works, e.g.
# google/gemini-2.5-flash; openrouter/auto lets OpenRouter pick.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
# Thinking budget for reasoning models: none|minimal|low|medium|high|xhigh.
OPENROUTER_REASONING_EFFORT=low
# Checks each chat message before the assistant sees it; the chat answers 503
# when it fails or takes over 4 s.
OPENROUTER_MODERATION_MODEL=openai/gpt-oss-safeguard-20b
# Shared Vercel Blob token for knowledge PDFs and profile images. A private
# store cannot provide public profile URLs; see docs/docs-for-FE/profile-follow.md.
# Get it from Vercel dashboard → Storage → Blob → .env.local.
# Leave empty to disable uploads (503).
BLOB_READ_WRITE_TOKEN=
# Public URL Vercel Blob calls when an upload finishes:
# https://<api>/api/v1/webhooks/vercel-blob. Only this callback confirms
# uploads, so uploads answer 503 without it. Locally, tunnel the API, e.g.
# `cloudflared tunnel --url http://localhost:4000`.
BLOB_CALLBACK_URL=
MAX_KNOWLEDGE_FILE_MB=50
# Knowledge base vectors; required. `docker compose up -d qdrant` runs one locally.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=vedora_knowledge
# Multimodal: text chunks and PDF images share one vector space.
OPENROUTER_EMBEDDING_MODEL=google/gemini-embedding-2
# Changing the model or size needs a new QDRANT_COLLECTION (and a re-upload).
KNOWLEDGE_EMBEDDING_DIMENSIONS=1536
# Leave empty to skip reranking.
OPENROUTER_RERANK_MODEL=qwen/qwen3-reranker-8b
FRONTEND_URL=http://localhost:3000
MAX_VIDEO_DURATION_SEC=180
SEED_USER_PASSWORD=VedoraDev123!

# Used when running the API directly on the host.
DATABASE_URL=postgresql://vedora:vedora_local_password@localhost:5432/vedora?schema=public
POSTGRES_DB=vedora
POSTGRES_USER=vedora
POSTGRES_PASSWORD=vedora_local_password
