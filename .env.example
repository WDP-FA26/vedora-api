NODE_ENV=development
ADMIN_WORK_PREVIEW_LIMIT=10
ADMIN_WORK_REFRESH_SECONDS=30
ADMIN_WORK_QUERY_TIMEOUT_MS=5000
ADMIN_WORK_TITLE_MAX_LENGTH=120
REPORT_MAX_EVIDENCE_IMAGES=3
REPORT_EVIDENCE_MAX_MB=5
REPORT_EVIDENCE_URL_TTL_SECONDS=900
REPORT_EVIDENCE_MAX_PENDING_UPLOADS=12
REPORT_EVIDENCE_CLEANUP_AGE_SECONDS=86400
REPORT_EVIDENCE_CLEANUP_BATCH_SIZE=100
REPORT_EVIDENCE_CLEANUP_CRON="0 45 * * * *"
SYSTEM_LOG_QUERY_MAX_LENGTH=100
SYSTEM_LOG_WRITE_TIMEOUT_MS=2000
SYSTEM_LOG_QUERY_TIMEOUT_MS=5000
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=local-development-secret-change-me-12345
JWT_ACCESS_TTL=3600
REFRESH_TOKEN_TTL=2592000
# Seconds a just-rotated refresh token may be sent again (0-60); 0 turns the grace off
REFRESH_TOKEN_REUSE_GRACE_SECONDS=30
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google
# Leave empty locally to print verification codes in the API log.
RESEND_API_KEY=
MAIL_FROM=Vedora <onboarding@resend.dev>
# Cloudinary video uploads (https://console.cloudinary.com → Settings → API Keys).
# Leave empty to disable uploads (503).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Videos go to <folder>/videos, caption files to <folder>/captions.
CLOUDINARY_FOLDER=vedora
# true once Settings → Webhook Notifications sends Upload and Eager events to
# <api>/api/v1/webhooks/cloudinary (locally through `cloudflared tunnel`).
# false: the API asks the Admin API for upload status when it's polled.
CLOUDINARY_WEBHOOKS_ENABLED=false
# Transcribe videos with a speech-to-text model of AI_PROVIDER (silence is cut
# out first) and translate them Vietnamese <-> English with AI_CHAT_MODEL.
# A video's transcript is moderated before its post is published, so turning
# captions off also turns off transcript moderation.
CAPTIONS_ENABLED=true
TRANSCRIPTION_MODEL=elevenlabs/scribe-v2
# Vedora AI (a built-in account nobody can sign in to) reads each newly
# published post (text + video transcripts, or a blog) with AI_CHAT_MODEL,
# stores a summary and recipe draft in post_summaries, and comments it on the
# post. Only posts published within POST_SUMMARY_WINDOW_SECONDS are picked up.
POST_SUMMARIES_ENABLED=true
# ffmpeg for audio extraction; defaults to the binary from ffmpeg-static.
# FFMPEG_PATH=/usr/bin/ffmpeg
# Which provider serves every AI call (chat, embeddings, rerank, captions,
# OCR, images): gateway (Vercel AI Gateway, the default) or openrouter, the
# backup. When the Gateway is down, set AI_PROVIDER=openrouter and restart.
# Chat, embedding and transcription model ids are the same on both; image, OCR
# and rerank models are set per provider below.
AI_PROVIDER=gateway
# Vercel AI Gateway key (https://vercel.com/docs/ai-gateway); required at startup
# alongside OPENROUTER_API_KEY. Also powers the meal planner voice agent.
AI_GATEWAY_API_KEY=
# Gateway providers the chat models try first, in order; the Gateway still
# moves to its other hosts when they fail. Empty lets the Gateway route.
AI_GATEWAY_PROVIDER_ORDER=anthropic
# OpenRouter (https://openrouter.ai/settings/keys): the backup provider;
# required at startup alongside AI_GATEWAY_API_KEY so switching works and cost
# reconcile of OpenRouter calls works. The API refuses to start when either is empty.
OPENROUTER_API_KEY=
AI_CHAT_MODEL=anthropic/claude-haiku-5.5
# With AI_PROVIDER=openrouter: OpenRouter providers the chat models
# (AI_CHAT_MODEL, BLOG_AI_MODEL) try first, in order; the rest stay as fallbacks. Keeps structured outputs and the
# prompt cache on one provider. Empty lets OpenRouter route.
OPENROUTER_PROVIDER_ORDER=anthropic,google-vertex/global,azure/global
# Thinking budget for reasoning models: none|minimal|low|medium|high|xhigh.
AI_REASONING_EFFORT=low
# Meal planner voice agent through Vercel AI Gateway (realtime, AI_GATEWAY_API_KEY).
# Without the key POST /meal-plan/voice/session answers 503. The model is any
# Gateway realtime id, e.g. openai/gpt-live-1.1 or spacexai/grok-voice-3.0.
VOICE_REALTIME_MODEL=openai/gpt-live-1.1
# Checks each chat message before the assistant sees it; the chat answers 503
# when it fails or takes over 10 s.
AI_MODERATION_MODEL=anthropic/claude-haiku-5.5
# Posts, comments, blogs and videos are rated by this model in one call: a
# risk level 0-3 (0-1 published, 2 waits for an admin, 3 rejected when backed
# by a quote from the post), the category, and the evidence admins see.
# Needs a chat model that reads images and supports structured outputs.
AI_CONTENT_MODERATION_MODEL=anthropic/claude-haiku-5.5
# OpenRouter providers both moderation models try first, in order (slugs,
# comma-separated); the rest stay as fallbacks. Empty lets OpenRouter route.
OPENROUTER_MODERATION_PROVIDER_ORDER=anthropic,google-vertex/global,azure/global
# App attribution headers sent to AI providers (`HTTP-Referer` and `X-Title` / `X-OpenRouter-Title`).
AI_APP_URL=https://vedora-opal.vercel.app
AI_APP_TITLE=Vedora Platform
# File storage: RustFS (S3-compatible), run by `docker compose up -d rustfs`.
# The API creates the buckets and event bindings on startup. Leave the
# endpoint, keys or webhook token empty to disable uploads (503).
# How the API reaches RustFS.
STORAGE_ENDPOINT=http://localhost:9000
# How browsers reach RustFS: presigned uploads and public profile images.
STORAGE_PUBLIC_URL=http://localhost:9000
# RustFS root credentials; docker compose passes the same values to RustFS.
STORAGE_ACCESS_KEY=vedora
STORAGE_SECRET_KEY=vedora_local_storage_secret
# Bearer token RustFS sends with upload events to
# /api/v1/webhooks/storage/{knowledge,profiles}.
STORAGE_WEBHOOK_TOKEN=vedora_local_webhook_token
# Private bucket for professional-verification proof images (optional).
# STORAGE_VERIFICATIONS_BUCKET=vedora-verifications
# STORAGE_BLOGS_BUCKET=vedora-blogs
# Private bucket for images attached to support tickets (optional).
# STORAGE_SUPPORT_BUCKET=vedora-support
MAX_KNOWLEDGE_FILE_MB=50
# Knowledge base vectors; required. `docker compose up -d qdrant` runs one
# locally. Startup stops when Qdrant does not answer within 5 seconds.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=vedora_knowledge
# Multimodal: text chunks and PDF images share one vector space.
AI_EMBEDDING_MODEL=google/gemini-embedding-2
# Changing the model or size needs a new QDRANT_COLLECTION (and a re-upload).
KNOWLEDGE_EMBEDDING_DIMENSIONS=1536
# Rerank knowledge search results; false skips the reranker. The model is per
# provider; blank uses cohere/rerank-v5-fast on the Gateway and
# qwen/qwen3-reranker-8b on OpenRouter.
KNOWLEDGE_RERANK_ENABLED=true
AI_GATEWAY_RERANK_MODEL=
OPENROUTER_RERANK_MODEL=
# Post search: a separate collection, filled automatically from published posts.
# Changing the model, size or payload needs a new QDRANT_POSTS_COLLECTION (posts reindex on their own).
QDRANT_POSTS_COLLECTION=vedora_posts_v2
QDRANT_PROFILES_COLLECTION=vedora_profiles_v1
QDRANT_MENU_ITEMS_COLLECTION=vedora_menu_items_v1
POST_SEARCH_EMBEDDING_MODEL=google/gemini-embedding-2
POST_SEARCH_EMBEDDING_DIMENSIONS=768
# Cosine similarity a post needs to match by meaning alone (keyword matches always count).
POST_SEARCH_MIN_SCORE=0.65
# Blog writing assistant. Empty BLOG_AI_MODEL falls back to AI_CHAT_MODEL;
# pin a model that calls tools reliably.
BLOG_AI_MODEL=
# Blog image model per provider; blank uses microsoft/mai-image-2.7-flash on
# the Gateway and qwen/qwen-image-2.1-turbo on OpenRouter.
AI_GATEWAY_IMAGE_MODEL=
OPENROUTER_IMAGE_MODEL=
# Knowledge base PDF OCR, one page per call; blank uses mistral/mistral-small on
# the Gateway and mistralai/mistral-small-2603 (with OpenRouter's mistral-ocr
# PDF parser) on OpenRouter.
AI_GATEWAY_OCR_MODEL=
OPENROUTER_OCR_MODEL=
# Daily caps per user: assistant requests (each resume after an editor tool counts) and images.
# Authenticated AI allowance now follows the subscription cycle; see docs/docs-for-FE/subscriptions.md.
FRONTEND_URL=http://localhost:3000
MAX_VIDEO_DURATION_SEC=180
SEED_USER_PASSWORD=VedoraDev123!

# Used when running the API directly on the host. `directConnection=true`
# because the replica set advertises its in-network name (`mongo`); the compose
# service listens on 127.0.0.1:27017. Inside compose the API uses
# mongodb://USER:PASSWORD@mongo:27017/DB?authSource=admin&replicaSet=rs0
DATABASE_URL=mongodb://vedora:vedora_local_password@localhost:27017/vedora?authSource=admin&directConnection=true
MONGO_DB=vedora
MONGO_USER=vedora
MONGO_PASSWORD=vedora_local_password
# Test suites (npm test, test:e2e, test:db) start an ephemeral single-node
# MongoDB replica set via mongodb-memory-server automatically. Set
# TEST_DATABASE_URL only if you want to point them at an external disposable
# replica set instead; every spec creates and drops its own database on it, so
# never point this at real data.
# TEST_DATABASE_URL=mongodb://localhost:27017/?directConnection=true

# Cloudflare Turnstile secret for password login and guest nutrition chat. Unset outside
# production uses Cloudflare's always-pass test secret.
TURNSTILE_SECRET_KEY=
# Guest chat caps per day: per session, per IP, and for all guests together.
GUEST_DAILY_MESSAGES=5
GUEST_DAILY_MESSAGES_PER_IP=20
GUEST_DAILY_BUDGET=500
# Header carrying the visitor's IP. Behind a Cloudflare Tunnel: cf-connecting-ip.
# Leave empty when the API can be reached directly, or the header can be faked.
CLIENT_IP_HEADER=

# SePay Banking QR (disabled until receiving account + webhook are configured).
# QR transfers use real bank money; there is no sandbox switch for bank transfers.
SEPAY_PAYMENT_ENABLED=false
SEPAY_PAYMENT_FLOW=bank_transfer_qr
SEPAY_QR_BANK_CODE=
# Exact Banking payload.gateway name, e.g. Vietcombank (may differ from QR code VCB).
SEPAY_BANK_GATEWAY=
SEPAY_QR_ACCOUNT_NUMBER=
SEPAY_QR_ACCOUNT_HOLDER=
SEPAY_QR_STORE_NAME=Vedora
SEPAY_QR_TRANSFER_PREFIX=
# SePay template: this prefix + exactly 6 letters/digits; keep webhook code/prefix filters enabled.
SEPAY_PAYMENT_CODE_PREFIX=VED
SEPAY_BANK_WEBHOOK_API_KEY=
# Server-owned prices; existing intents keep their original price/duration.
SUBSCRIPTION_PLUS_PRICE_VND=49000
SUBSCRIPTION_PRO_PRICE_VND=99000
BILLING_DURATION_DAYS=30
# SSE fanout only (no queues/tokens). Blank disables realtime; GET still works.
# Direct host API: redis://127.0.0.1:6379; Docker API: redis://redis:6379.
PAYMENT_REDIS_URL=
# Different environments sharing Redis MUST use different channels (Redis DB index is not isolation).
PAYMENT_EVENTS_CHANNEL=vedora:payments:v1

