NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=local-development-secret-change-me-12345
JWT_ACCESS_TTL=3600
REFRESH_TOKEN_TTL=2592000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google
# Leave empty locally to print verification codes in the API log.
RESEND_API_KEY=
MAIL_FROM=Vedora <onboarding@resend.dev>
# Cloudinary video uploads (https://console.cloudinary.com → Settings → API Keys).
# Leave empty to disable uploads (503).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Videos go to <folder>/videos, caption files to <folder>/captions.
CLOUDINARY_FOLDER=vedora
# true once Settings → Webhook Notifications sends Upload and Eager events to
# <api>/api/v1/webhooks/cloudinary (locally through `cloudflared tunnel`).
# false: the API asks the Admin API for upload status when it's polled.
CLOUDINARY_WEBHOOKS_ENABLED=false
# Transcribe published videos with Whisper on OpenRouter (silence is cut out
# first) and translate them Vietnamese <-> English with OPENROUTER_MODEL.
CAPTIONS_ENABLED=true
TRANSCRIPTION_MODEL=openai/whisper-large-v3
# ffmpeg for audio extraction; defaults to the binary from ffmpeg-static.
# FFMPEG_PATH=/usr/bin/ffmpeg
# OpenRouter (https://openrouter.ai/settings/keys) runs the nutrition assistant
# and the knowledge base; required. Any OpenRouter model id works, e.g.
# google/gemini-2.5-flash; openrouter/auto lets OpenRouter pick.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
# Thinking budget for reasoning models: none|minimal|low|medium|high|xhigh.
OPENROUTER_REASONING_EFFORT=low
# Checks each chat message before the assistant sees it; the chat answers 503
# when it fails or takes over 4 s.
OPENROUTER_MODERATION_MODEL=openai/gpt-oss-safeguard-20b
# File storage: RustFS (S3-compatible), run by `docker compose up -d rustfs`.
# The API creates the buckets and event bindings on startup. Leave the
# endpoint, keys or webhook token empty to disable uploads (503).
# How the API reaches RustFS.
STORAGE_ENDPOINT=http://localhost:9000
# How browsers reach RustFS: presigned uploads and public profile images.
STORAGE_PUBLIC_URL=http://localhost:9000
# RustFS root credentials; docker compose passes the same values to RustFS.
STORAGE_ACCESS_KEY=vedora
STORAGE_SECRET_KEY=vedora_local_storage_secret
# Bearer token RustFS sends with upload events to
# /api/v1/webhooks/storage/{knowledge,profiles}.
STORAGE_WEBHOOK_TOKEN=vedora_local_webhook_token
# Private bucket for professional-verification proof images (optional).
# STORAGE_VERIFICATIONS_BUCKET=vedora-verifications
MAX_KNOWLEDGE_FILE_MB=50
# Knowledge base vectors; required. `docker compose up -d qdrant` runs one locally.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=vedora_knowledge
# Multimodal: text chunks and PDF images share one vector space.
OPENROUTER_EMBEDDING_MODEL=google/gemini-embedding-2
# Changing the model or size needs a new QDRANT_COLLECTION (and a re-upload).
KNOWLEDGE_EMBEDDING_DIMENSIONS=1536
# Leave empty to skip reranking.
OPENROUTER_RERANK_MODEL=qwen/qwen3-reranker-8b
# Post search: a separate collection, filled automatically from published posts.
# Changing the model or size needs a new QDRANT_POSTS_COLLECTION (posts reindex on their own).
QDRANT_POSTS_COLLECTION=vedora_posts
POST_SEARCH_EMBEDDING_MODEL=google/gemini-embedding-2
POST_SEARCH_EMBEDDING_DIMENSIONS=768
# Cosine similarity a post needs to match by meaning alone (keyword matches always count).
POST_SEARCH_MIN_SCORE=0.65
FRONTEND_URL=http://localhost:3000
MAX_VIDEO_DURATION_SEC=180
SEED_USER_PASSWORD=VedoraDev123!

# Used when running the API directly on the host.
# If this goes through a transaction-mode pooler (PgBouncer, Neon "-pooler"),
# also set DIRECT_URL to the direct connection: the container migrates with it.
DATABASE_URL=postgresql://vedora:vedora_local_password@localhost:5432/vedora?schema=public
POSTGRES_DB=vedora
POSTGRES_USER=vedora
POSTGRES_PASSWORD=vedora_local_password

# Cloudflare Turnstile secret for the guest nutrition chat. Unset outside
# production uses Cloudflare's always-pass test secret.
TURNSTILE_SECRET_KEY=
# Guest chat caps per day: per session, per IP, and for all guests together.
GUEST_DAILY_MESSAGES=5
GUEST_DAILY_MESSAGES_PER_IP=20
GUEST_DAILY_BUDGET=500
# Header carrying the visitor's IP. Behind a Cloudflare Tunnel: cf-connecting-ip.
# Leave empty when the API can be reached directly, or the header can be faked.
CLIENT_IP_HEADER=
