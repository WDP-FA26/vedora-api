generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(uuid()) @db.Uuid
  username              String                 @unique @db.VarChar(30)
  passwordHash          String?                @map("password_hash") @db.VarChar(60)
  googleId              String?                @unique @map("google_id") @db.VarChar(255)
  fullName              String                 @map("full_name") @db.VarChar(100)
  email                 String                 @unique @db.VarChar(320)
  /// Null until the user proves they own `email` (OTP code or Google).
  emailVerifiedAt       DateTime?              @map("email_verified_at")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  refreshTokens         RefreshToken[]
  emailVerificationCode EmailVerificationCode?
  posts                 Post[]
  media                 MediaAsset[]

  @@map("users")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  familyId          String    @map("family_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  userId            String    @map("user_id") @db.Uuid
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// The one pending email-verification code per user. Only its hash is stored.
model EmailVerificationCode {
  userId      String   @id @map("user_id") @db.Uuid
  codeHash    String   @map("code_hash") @db.Char(64)
  attempts    Int      @default(0)
  expiresAt   DateTime @map("expires_at")
  sentAt      DateTime @map("sent_at")
  /// Start of the current resend window; `resendCount` resets after it.
  firstSentAt DateTime @map("first_sent_at")
  resendCount Int      @default(0) @map("resend_count")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_codes")
}

/// Code guesses per email address. Kept apart from users and codes, so neither
/// new codes nor deleting and re-registering the account resets the count.
model EmailVerificationGuesses {
  email       String   @id @db.VarChar(320)
  guesses     Int      @default(0)
  windowStart DateTime @map("window_start")

  @@map("email_verification_guesses")
}

enum PostType {
  POST
  /// Long-form post. Its content will live in a `Blog` row linked 1:1 to the
  /// post; not implemented yet, so the API only accepts `POST`.
  BLOG
}

enum PostStatus {
  /// Waiting for attached media to finish processing; visible to its author only.
  PROCESSING
  PUBLISHED
  FAILED
}

model Post {
  id          String       @id @default(uuid()) @db.Uuid
  authorId    String       @map("author_id") @db.Uuid
  type        PostType     @default(POST)
  status      PostStatus   @default(PROCESSING)
  body        String?      @db.VarChar(280)
  publishedAt DateTime?    @map("published_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  author      User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media       MediaAsset[]

  @@index([status, publishedAt])
  @@index([authorId, createdAt])
  @@map("posts")
}

enum MediaType {
  VIDEO
  IMAGE
}

enum MediaStatus {
  /// Upload URL issued; the browser has not finished sending the file.
  WAITING_UPLOAD
  /// File received; Mux is encoding it.
  PROCESSING
  READY
  FAILED
}

enum MediaFailureReason {
  /// Longer than `MAX_VIDEO_DURATION_SEC`; deleted from Mux.
  TOO_LONG
  ENCODING_FAILED
  UPLOAD_ERRORED
  UPLOAD_CANCELLED
  UPLOAD_TIMED_OUT
  /// Mux created the asset without a public playback ID.
  NO_PLAYBACK_ID
}

/// A file a user uploaded, attached to at most one post. Videos are hosted by
/// Mux: `id` is sent as the asset's `passthrough`, so webhooks map back to it.
model MediaAsset {
  id            String              @id @default(uuid()) @db.Uuid
  /// Null once the owner's account is deleted; the purge cron then removes
  /// the media from Mux before dropping the row.
  ownerId       String?             @map("owner_id") @db.Uuid
  type          MediaType
  status        MediaStatus         @default(WAITING_UPLOAD)
  /// Set when `status` is FAILED.
  failureReason MediaFailureReason? @map("failure_reason")
  postId        String?             @map("post_id") @db.Uuid
  position      Int                 @default(0)
  muxUploadId   String?             @unique @map("mux_upload_id") @db.VarChar(255)
  muxAssetId    String?             @unique @map("mux_asset_id") @db.VarChar(255)
  playbackId    String?             @map("playback_id") @db.VarChar(255)
  durationSec   Float?              @map("duration_sec")
  aspectRatio   String?             @map("aspect_ratio") @db.VarChar(16)
  /// Set when the upload was discarded; the row stays until its Mux upload
  /// and asset are confirmed gone, so late webhooks can still clean up.
  discardedAt   DateTime?           @map("discarded_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  owner         User?               @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  post          Post?               @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([ownerId, status])
  @@index([postId])
  @@index([status, updatedAt])
  @@index([discardedAt])
  @@map("media_assets")
}
