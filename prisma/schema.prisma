generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id                    String                 @id @default(uuid()) @db.Uuid
  username              String                 @unique @db.VarChar(30)
  passwordHash          String?                @map("password_hash") @db.VarChar(60)
  googleId              String?                @unique @map("google_id") @db.VarChar(255)
  fullName              String                 @map("full_name") @db.VarChar(100)
  email                 String                 @unique @db.VarChar(320)
  bio                   String?                @db.VarChar(500)
  avatarUrl             String?                @map("avatar_url") @db.VarChar(2048)
  coverUrl              String?                @map("cover_url") @db.VarChar(2048)
  role                  UserRole               @default(USER)
  /// Set when an admin approves a verification request; shown as a badge.
  isProfessional        Boolean                @default(false) @map("is_professional")
  /// Null until the user proves they own `email` (OTP code or Google).
  emailVerifiedAt       DateTime?              @map("email_verified_at")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  refreshTokens         RefreshToken[]
  emailVerificationCode EmailVerificationCode?
  posts                 Post[]
  postComments          PostComment[]
  postLikes             PostLike[]
  media                 MediaAsset[]
  knowledgeDocuments    KnowledgeDocument[]
  following             Follow[]               @relation("Following")
  followers             Follow[]               @relation("Followers")
  profileImages         ProfileImageUpload[]
  verificationRequests  VerificationRequest[]
  verificationReviews   VerificationRequest[]  @relation("VerificationReviewer")
  verificationProofs    VerificationProof[]

  @@map("users")
}

model Follow {
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId, createdAt, followerId])
  @@index([followerId, createdAt, followingId])
  @@map("follows")
}

enum ProfileImageKind {
  AVATAR
  COVER
}

enum ProfileImageStatus {
  WAITING_UPLOAD
  READY
}

model ProfileImageUpload {
  id         String             @id @default(uuid()) @db.Uuid
  ownerId    String?            @map("owner_id") @db.Uuid
  kind       ProfileImageKind
  status     ProfileImageStatus @default(WAITING_UPLOAD)
  storageKey String             @unique @map("storage_key") @db.VarChar(512)
  createdAt  DateTime           @default(now()) @map("created_at")
  owner      User?              @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId, status])
  @@index([status, createdAt])
  @@map("profile_image_uploads")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  familyId          String    @map("family_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  userId            String    @map("user_id") @db.Uuid
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// The one pending email-verification code per user. Only its hash is stored.
model EmailVerificationCode {
  userId      String   @id @map("user_id") @db.Uuid
  codeHash    String   @map("code_hash") @db.Char(64)
  attempts    Int      @default(0)
  expiresAt   DateTime @map("expires_at")
  sentAt      DateTime @map("sent_at")
  /// Start of the current resend window; `resendCount` resets after it.
  firstSentAt DateTime @map("first_sent_at")
  resendCount Int      @default(0) @map("resend_count")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_codes")
}

/// Code guesses per email address. Kept apart from users and codes, so neither
/// new codes nor deleting and re-registering the account resets the count.
model EmailVerificationGuesses {
  email       String   @id @db.VarChar(320)
  guesses     Int      @default(0)
  windowStart DateTime @map("window_start")

  @@map("email_verification_guesses")
}

enum PostType {
  POST
  /// Long-form post. Its content will live in a `Blog` row linked 1:1 to the
  /// post; not implemented yet, so the API only accepts `POST`.
  BLOG
}

enum PostStatus {
  /// Waiting for attached media to finish processing; visible to its author only.
  PROCESSING
  PUBLISHED
  FAILED
}

model Post {
  id          String        @id @default(uuid()) @db.Uuid
  authorId    String        @map("author_id") @db.Uuid
  type        PostType      @default(POST)
  status      PostStatus    @default(PROCESSING)
  body        String?       @db.VarChar(280)
  publishedAt DateTime?     @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  author      User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media       MediaAsset[]
  comments    PostComment[]
  likes       PostLike[]

  @@index([status, publishedAt])
  @@index([authorId, createdAt])
  @@map("posts")
}

model PostComment {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String   @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt, id])
  @@index([authorId])
  @@map("post_comments")
}

model PostLike {
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
  @@map("post_likes")
}

enum MediaType {
  VIDEO
  IMAGE
}

enum MediaStatus {
  /// Upload URL issued; the browser has not finished sending the file.
  WAITING_UPLOAD
  /// File received; Mux is encoding it.
  PROCESSING
  READY
  FAILED
}

enum MediaFailureReason {
  /// Longer than `MAX_VIDEO_DURATION_SEC`; deleted from Mux.
  TOO_LONG
  ENCODING_FAILED
  UPLOAD_ERRORED
  UPLOAD_CANCELLED
  UPLOAD_TIMED_OUT
  /// Mux created the asset without a public playback ID.
  NO_PLAYBACK_ID
}

/// Mux Robots captions for a published video: generated in the spoken
/// language, then translated between Vietnamese and English.
enum CaptionStatus {
  /// Not started; only videos of published posts get captions.
  NONE
  /// The `generate-premium-captions` job in `captionJobId` is running.
  GENERATING
  /// The generated track `captionTrackId` is being attached to the asset.
  ATTACHING
  /// The `translate-captions` job in `captionJobId` is running.
  TRANSLATING
  /// Captions are attached; the translation may have failed (logged).
  READY
  /// No speech to caption, so nothing was attached.
  NO_SPEECH
  FAILED
}

/// A file a user uploaded, attached to at most one post. Videos are hosted by
/// Mux: `id` is sent as the asset's `passthrough`, so webhooks map back to it.
model MediaAsset {
  id              String              @id @default(uuid()) @db.Uuid
  /// Null once the owner's account is deleted; the purge cron then removes
  /// the media from Mux before dropping the row.
  ownerId         String?             @map("owner_id") @db.Uuid
  type            MediaType
  status          MediaStatus         @default(WAITING_UPLOAD)
  /// Set when `status` is FAILED.
  failureReason   MediaFailureReason? @map("failure_reason")
  postId          String?             @map("post_id") @db.Uuid
  position        Int                 @default(0)
  muxUploadId     String?             @unique @map("mux_upload_id") @db.VarChar(255)
  muxAssetId      String?             @unique @map("mux_asset_id") @db.VarChar(255)
  playbackId      String?             @map("playback_id") @db.VarChar(255)
  durationSec     Float?              @map("duration_sec")
  aspectRatio     String?             @map("aspect_ratio") @db.VarChar(16)
  captionStatus   CaptionStatus       @default(NONE) @map("caption_status")
  /// Spoken language Mux detected, e.g. `vi`.
  captionLanguage String?             @map("caption_language") @db.VarChar(16)
  captionTrackId  String?             @map("caption_track_id") @db.VarChar(255)
  captionJobId    String?             @map("caption_job_id") @db.VarChar(255)
  /// Set when the upload was discarded; the row stays until its Mux upload
  /// and asset are confirmed gone, so late webhooks can still clean up.
  discardedAt     DateTime?           @map("discarded_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  owner           User?               @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  post            Post?               @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([ownerId, status])
  @@index([postId])
  @@index([status, updatedAt])
  @@index([discardedAt])
  @@index([captionStatus, updatedAt])
  @@index([captionJobId])
  @@index([captionTrackId])
  @@map("media_assets")
}

enum KnowledgeDocumentStatus {
  /// Upload URL issued; RustFS has not reported the file yet.
  WAITING_UPLOAD
  /// File is in RustFS; its text and images are being extracted and
  /// indexed into Qdrant.
  PROCESSING
  READY
  FAILED
}

enum KnowledgeDocumentFailureReason {
  /// No RustFS upload event arrived before the upload URL expired.
  UPLOAD_EXPIRED
  /// The extractor could not open the file as its content type.
  INVALID_FILE
  /// The file is password-protected.
  ENCRYPTED
  /// Neither text nor images to extract.
  NO_TEXT
  /// Extraction errored, or was interrupted (e.g. by a restart).
  EXTRACTION_FAILED
  INDEXING_FAILED
}

/// A file uploaded to RustFS for the nutrition chatbot's knowledge base.
/// The browser uploads it directly with a URL presigned for `storageKey`;
/// its text chunks and images are then embedded into Qdrant.
model KnowledgeDocument {
  id            String                          @id @default(uuid()) @db.Uuid
  uploadedById  String?                         @map("uploaded_by_id") @db.Uuid
  /// The original file name, shown in the admin UI.
  title         String                          @db.VarChar(255)
  /// Always application/pdf today; the presigned URL only accepts it.
  contentType   String                          @map("content_type") @db.VarChar(255)
  storageKey    String                          @unique @map("storage_key") @db.VarChar(512)
  /// Set once the text has been extracted.
  sizeBytes     Int?                            @map("size_bytes")
  status        KnowledgeDocumentStatus         @default(WAITING_UPLOAD)
  /// Set when `status` is FAILED.
  failureReason KnowledgeDocumentFailureReason? @map("failure_reason")
  sectionCount  Int?                            @map("section_count")
  imageCount    Int?                            @map("image_count")
  createdAt     DateTime                        @default(now()) @map("created_at")
  updatedAt     DateTime                        @updatedAt @map("updated_at")
  uploadedBy    User?                           @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
  @@map("knowledge_documents")
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A user's claim to be a food professional, with a statement and proof
/// images, for an admin to approve or reject. A user has at most one PENDING request.
model VerificationRequest {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @map("user_id") @db.Uuid
  statement    String              @db.VarChar(2000)
  status       VerificationStatus  @default(PENDING)
  /// The admin's reason; required when REJECTED and shown to the user.
  reviewNote   String?             @map("review_note") @db.VarChar(500)
  reviewedById String?             @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?           @map("reviewed_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?               @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  proofs       VerificationProof[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("verification_requests")
}

/// A proof image in the private verifications bucket. Rows outlive their
/// owner and request, so the purge cron can delete the stored file first.
model VerificationProof {
  id         String               @id @default(uuid()) @db.Uuid
  ownerId    String?              @map("owner_id") @db.Uuid
  /// Null until the image is submitted with a request.
  requestId  String?              @map("request_id") @db.Uuid
  storageKey String               @unique @map("storage_key") @db.VarChar(512)
  createdAt  DateTime             @default(now()) @map("created_at")
  owner      User?                @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  request    VerificationRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([ownerId, requestId])
  @@index([requestId, createdAt])
  @@map("verification_proofs")
}
