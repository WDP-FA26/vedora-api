generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id                    String                  @id @default(uuid()) @db.Uuid
  username              String                  @unique @db.VarChar(30)
  passwordHash          String?                 @map("password_hash") @db.VarChar(60)
  googleId              String?                 @unique @map("google_id") @db.VarChar(255)
  fullName              String                  @map("full_name") @db.VarChar(100)
  email                 String                  @unique @db.VarChar(320)
  bio                   String?                 @db.VarChar(500)
  avatarUrl             String?                 @map("avatar_url") @db.VarChar(2048)
  coverUrl              String?                 @map("cover_url") @db.VarChar(2048)
  role                  UserRole                @default(USER)
  /// Set when an admin approves a verification request; shown as a badge.
  isProfessional        Boolean                 @default(false) @map("is_professional")
  /// Null until the user proves they own `email` (OTP code or Google).
  emailVerifiedAt       DateTime?               @map("email_verified_at")
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  refreshTokens         RefreshToken[]
  emailVerificationCode EmailVerificationCode?
  passwordResetCode     PasswordResetCode?
  posts                 Post[]
  postComments          PostComment[]
  postLikes             PostLike[]
  postReposts           PostRepost[]
  postBookmarks         PostBookmark[]
  postReports           PostReport[]
  postReportReviews     PostReport[]            @relation("PostReportReviewer")
  media                 MediaAsset[]
  knowledgeDocuments    KnowledgeDocument[]
  following             Follow[]                @relation("Following")
  followers             Follow[]                @relation("Followers")
  profileImages         ProfileImageUpload[]
  verificationRequests  VerificationRequest[]
  verificationReviews   VerificationRequest[]   @relation("VerificationReviewer")
  verificationProofs    VerificationProof[]
  recipes               Recipe[]
  avoidedIngredients    UserAvoidedIngredient[]
  avoidedGroups         UserAvoidedGroup[]
  likedIngredients      UserLikedIngredient[]
  mealPlan              MealPlanEntry[]
  recipeFavorites       RecipeFavorite[]

  @@map("users")
}

model Follow {
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId, createdAt, followerId])
  @@index([followerId, createdAt, followingId])
  @@map("follows")
}

enum ProfileImageKind {
  AVATAR
  COVER
}

enum ProfileImageStatus {
  WAITING_UPLOAD
  READY
}

model ProfileImageUpload {
  id         String             @id @default(uuid()) @db.Uuid
  ownerId    String?            @map("owner_id") @db.Uuid
  kind       ProfileImageKind
  status     ProfileImageStatus @default(WAITING_UPLOAD)
  storageKey String             @unique @map("storage_key") @db.VarChar(512)
  createdAt  DateTime           @default(now()) @map("created_at")
  owner      User?              @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId, status])
  @@index([status, createdAt])
  @@map("profile_image_uploads")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  familyId          String    @map("family_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  userId            String    @map("user_id") @db.Uuid
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// The one pending email-verification code per user. Only its hash is stored.
model EmailVerificationCode {
  userId      String   @id @map("user_id") @db.Uuid
  codeHash    String   @map("code_hash") @db.Char(64)
  attempts    Int      @default(0)
  expiresAt   DateTime @map("expires_at")
  sentAt      DateTime @map("sent_at")
  /// Start of the current resend window; `resendCount` resets after it.
  firstSentAt DateTime @map("first_sent_at")
  resendCount Int      @default(0) @map("resend_count")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_codes")
}

/// The one pending password-reset code per user, emailed by "forgot password".
/// Same rules as `EmailVerificationCode`; only its hash is stored.
model PasswordResetCode {
  userId      String   @id @map("user_id") @db.Uuid
  codeHash    String   @map("code_hash") @db.Char(64)
  attempts    Int      @default(0)
  expiresAt   DateTime @map("expires_at")
  sentAt      DateTime @map("sent_at")
  /// Start of the current resend window; `resendCount` resets after it.
  firstSentAt DateTime @map("first_sent_at")
  resendCount Int      @default(0) @map("resend_count")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_codes")
}

/// Code guesses per email address, for verification and reset codes alike.
/// Kept apart from users and codes, so neither new codes nor deleting and
/// re-registering the account resets the count.
model EmailVerificationGuesses {
  email       String   @id @db.VarChar(320)
  guesses     Int      @default(0)
  windowStart DateTime @map("window_start")

  @@map("email_verification_guesses")
}

enum PostType {
  POST
  /// Long-form article with a Blog row linked 1:1 to the post.
  BLOG
}

enum PostStatus {
  /// A private blog that has not been published.
  DRAFT
  /// Waiting for attached media to finish processing; visible to its author only.
  PROCESSING
  PUBLISHED
  FAILED
}

model Post {
  id              String         @id @default(uuid()) @db.Uuid
  authorId        String         @map("author_id") @db.Uuid
  type            PostType       @default(POST)
  status          PostStatus     @default(PROCESSING)
  /// Up to 250 words (`MAX_POST_BODY_WORDS`); the length cap only bounds very long words.
  body            String?        @db.VarChar(2000)
  /// When the body was embedded into the Qdrant post search collection; null
  /// while it still needs indexing (see `PostSearchService`).
  searchIndexedAt DateTime?      @map("search_indexed_at")
  /// Viewable impressions, added in batches by `PostViewsService`.
  viewCount       Int            @default(0) @map("view_count")
  publishedAt     DateTime?      @map("published_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  author          User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  media           MediaAsset[]
  comments        PostComment[]
  likes           PostLike[]
  reposts         PostRepost[]
  bookmarks       PostBookmark[]
  reports         PostReport[]
  recipes         Recipe[]
  blog            Blog?

  @@index([status, publishedAt])
  @@index([authorId, createdAt])
  @@map("posts")
}

/// Uses the post ID for feed, comments, likes and bookmarks.
model Blog {
  postId        String       @id @map("post_id") @db.Uuid
  title         String       @db.VarChar(150)
  coverImageUrl String?      @map("cover_image_url") @db.VarChar(2048)
  /// Markdown source; clients render with raw HTML disabled.
  content       String       @db.Text
  /// A short source-text preview, never rendered as HTML.
  excerpt       String       @db.VarChar(280)
  updatedAt     DateTime     @updatedAt @map("updated_at")
  post          Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  recipes       BlogRecipe[]

  @@map("blogs")
}

model BlogRecipe {
  postId   String @map("post_id") @db.Uuid
  recipeId String @map("recipe_id") @db.Uuid
  position Int
  blog     Blog   @relation(fields: [postId], references: [postId], onDelete: Cascade)
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([postId, recipeId])
  @@index([recipeId])
  @@map("blog_recipes")
}

model PostComment {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  body      String   @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt, id])
  @@index([authorId])
  @@map("post_comments")
}

model PostLike {
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
  @@map("post_likes")
}

model PostRepost {
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, createdAt])
  @@map("post_reposts")
}

/// A post a user saved for later. Private: no count is shown on the post.
model PostBookmark {
  postId    String   @map("post_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, createdAt])
  @@map("post_bookmarks")
}

enum PostReportReason {
  SPAM
  HARASSMENT
  MISINFORMATION
  /// Diet or health advice that could hurt someone who follows it.
  HARMFUL_ADVICE
  INAPPROPRIATE
  OTHER
}

enum PostReportStatus {
  PENDING
  /// An admin acted on the post.
  RESOLVED
  /// An admin found nothing wrong.
  DISMISSED
}

model PostReport {
  id           String           @id @default(uuid()) @db.Uuid
  postId       String           @map("post_id") @db.Uuid
  reporterId   String           @map("reporter_id") @db.Uuid
  reason       PostReportReason
  details      String?          @db.VarChar(500)
  status       PostReportStatus @default(PENDING)
  reviewedById String?          @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?        @map("reviewed_at")
  createdAt    DateTime         @default(now()) @map("created_at")
  post         Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter     User             @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy   User?            @relation("PostReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  /// One report per person per post.
  @@unique([postId, reporterId])
  @@index([status, createdAt])
  @@map("post_reports")
}

enum MediaType {
  VIDEO
  IMAGE
}

enum MediaStatus {
  /// Upload signature issued; Cloudinary has not reported the file yet.
  WAITING_UPLOAD
  /// File received; Cloudinary is building its HLS stream.
  PROCESSING
  READY
  FAILED
}

enum MediaFailureReason {
  /// Longer than `MAX_VIDEO_DURATION_SEC`; deleted from Cloudinary.
  TOO_LONG
  /// Cloudinary could not build the HLS stream.
  ENCODING_FAILED
  /// The file vanished from Cloudinary before it was ready.
  UPLOAD_ERRORED
  /// No file arrived before the upload signature expired.
  UPLOAD_TIMED_OUT
}

/// Captions for a published video: Whisper transcribes the spoken language
/// (silence is cut out first), then the chat model translates it between
/// Vietnamese and English.
enum CaptionStatus {
  /// Not started; only videos of published posts get captions.
  NONE
  /// Transcription and translation are running in this API process.
  TRANSCRIBING
  /// Captions are stored; the translation may have failed (logged).
  READY
  /// No speech to caption, so nothing was stored.
  NO_SPEECH
  FAILED
}

/// A file a user uploaded, attached to at most one post. Videos are hosted by
/// Cloudinary under `publicId`, which embeds `id` so notifications map back.
model MediaAsset {
  id              String              @id @default(uuid()) @db.Uuid
  /// Null once the owner's account is deleted; the purge cron then removes
  /// the media from Cloudinary before dropping the row.
  ownerId         String?             @map("owner_id") @db.Uuid
  type            MediaType
  status          MediaStatus         @default(WAITING_UPLOAD)
  /// Set when `status` is FAILED.
  failureReason   MediaFailureReason? @map("failure_reason")
  postId          String?             @map("post_id") @db.Uuid
  position        Int                 @default(0)
  /// Cloudinary public ID, e.g. `vedora/videos/<id>`.
  publicId        String              @unique @map("public_id") @db.VarChar(255)
  durationSec     Float?              @map("duration_sec")
  aspectRatio     String?             @map("aspect_ratio") @db.VarChar(16)
  captionStatus   CaptionStatus       @default(NONE) @map("caption_status")
  /// Spoken language Whisper detected, e.g. `vi`.
  captionLanguage String?             @map("caption_language") @db.VarChar(16)
  /// Set when the upload was discarded; the row stays until Cloudinary
  /// confirms the files are gone, so late notifications can still clean up.
  discardedAt     DateTime?           @map("discarded_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  owner           User?               @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  post            Post?               @relation(fields: [postId], references: [id], onDelete: SetNull)
  captions        MediaCaption[]

  @@index([ownerId, status])
  @@index([postId])
  @@index([status, updatedAt])
  @@index([discardedAt])
  @@index([captionStatus, updatedAt])
  @@map("media_assets")
}

/// One WebVTT caption track of a video, stored on Cloudinary as a raw file.
model MediaCaption {
  id           String     @id @default(uuid()) @db.Uuid
  mediaId      String     @map("media_id") @db.Uuid
  /// e.g. `vi`; one track per language.
  languageCode String     @map("language_code") @db.VarChar(16)
  /// The language's own name, e.g. "Tiếng Việt".
  name         String     @db.VarChar(64)
  /// The spoken language, as opposed to its translation.
  isOriginal   Boolean    @map("is_original")
  url          String     @db.VarChar(1024)
  createdAt    DateTime   @default(now()) @map("created_at")
  media        MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, languageCode])
  @@map("media_captions")
}

enum KnowledgeDocumentStatus {
  /// Upload URL issued; RustFS has not reported the file yet.
  WAITING_UPLOAD
  /// File is in RustFS; its text and images are being extracted and
  /// indexed into Qdrant.
  PROCESSING
  READY
  FAILED
}

enum KnowledgeDocumentFailureReason {
  /// No RustFS upload event arrived before the upload URL expired.
  UPLOAD_EXPIRED
  /// The extractor could not open the file as its content type.
  INVALID_FILE
  /// The file is password-protected.
  ENCRYPTED
  /// Neither text nor images to extract.
  NO_TEXT
  /// Extraction errored, or was interrupted (e.g. by a restart).
  EXTRACTION_FAILED
  INDEXING_FAILED
}

/// A file uploaded to RustFS for the nutrition chatbot's knowledge base.
/// The browser uploads it directly with a URL presigned for `storageKey`;
/// its text chunks and images are then embedded into Qdrant.
model KnowledgeDocument {
  id            String                          @id @default(uuid()) @db.Uuid
  uploadedById  String?                         @map("uploaded_by_id") @db.Uuid
  /// The original file name, shown in the admin UI.
  title         String                          @db.VarChar(255)
  /// Always application/pdf today; the presigned URL only accepts it.
  contentType   String                          @map("content_type") @db.VarChar(255)
  storageKey    String                          @unique @map("storage_key") @db.VarChar(512)
  /// Set once the text has been extracted.
  sizeBytes     Int?                            @map("size_bytes")
  status        KnowledgeDocumentStatus         @default(WAITING_UPLOAD)
  /// Set when `status` is FAILED.
  failureReason KnowledgeDocumentFailureReason? @map("failure_reason")
  sectionCount  Int?                            @map("section_count")
  imageCount    Int?                            @map("image_count")
  createdAt     DateTime                        @default(now()) @map("created_at")
  updatedAt     DateTime                        @updatedAt @map("updated_at")
  uploadedBy    User?                           @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([status, updatedAt])
  @@map("knowledge_documents")
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A user's claim to be a food professional, with a statement and proof
/// images, for an admin to approve or reject. A user has at most one PENDING request.
model VerificationRequest {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @map("user_id") @db.Uuid
  statement    String              @db.VarChar(2000)
  status       VerificationStatus  @default(PENDING)
  /// The admin's reason; required when REJECTED and shown to the user.
  reviewNote   String?             @map("review_note") @db.VarChar(500)
  reviewedById String?             @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?           @map("reviewed_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?               @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  proofs       VerificationProof[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("verification_requests")
}

/// A proof image in the private verifications bucket. Rows outlive their
/// owner and request, so the purge cron can delete the stored file first.
model VerificationProof {
  id         String               @id @default(uuid()) @db.Uuid
  ownerId    String?              @map("owner_id") @db.Uuid
  /// Null until the image is submitted with a request.
  requestId  String?              @map("request_id") @db.Uuid
  storageKey String               @unique @map("storage_key") @db.VarChar(512)
  createdAt  DateTime             @default(now()) @map("created_at")
  owner      User?                @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  request    VerificationRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([ownerId, requestId])
  @@index([requestId, createdAt])
  @@map("verification_proofs")
}

/// One canonical food item; recipes and incompatibility rules point here.
model Ingredient {
  id        String                  @id @default(uuid()) @db.Uuid
  name      String                  @unique @db.VarChar(100)
  /// Other names for the same item, e.g. "đậu phụ" for "đậu hũ".
  aliases   String[]                @db.VarChar(100)
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @updatedAt @map("updated_at")
  groups    IngredientGroupMember[]
  recipes   RecipeIngredient[]
  rulesAsA  IncompatibilityRule[]   @relation("RuleIngredientA")
  rulesAsB  IncompatibilityRule[]   @relation("RuleIngredientB")
  avoidedBy UserAvoidedIngredient[]
  likedBy   UserLikedIngredient[]

  @@map("ingredients")
}

/// Ingredients that share incompatibility rules. Groups are flat: no group inside a group.
model IngredientGroup {
  id          String                  @id @default(uuid()) @db.Uuid
  name        String                  @unique @db.VarChar(100)
  description String?                 @db.VarChar(500)
  /// Offered to users as a food category they can avoid, e.g. dairy.
  dietary     Boolean                 @default(false)
  createdAt   DateTime                @default(now()) @map("created_at")
  updatedAt   DateTime                @updatedAt @map("updated_at")
  members     IngredientGroupMember[]
  rulesAsA    IncompatibilityRule[]   @relation("RuleGroupA")
  rulesAsB    IncompatibilityRule[]   @relation("RuleGroupB")
  avoidedBy   UserAvoidedGroup[]

  @@map("ingredient_groups")
}

model IngredientGroupMember {
  groupId      String          @map("group_id") @db.Uuid
  ingredientId String          @map("ingredient_id") @db.Uuid
  group        IngredientGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  ingredient   Ingredient      @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([groupId, ingredientId])
  @@index([ingredientId])
  @@map("ingredient_group_members")
}

/// "A should not be eaten with B". Each side is one ingredient or one group,
/// which the migration enforces with CHECK constraints.
model IncompatibilityRule {
  id            String           @id @default(uuid()) @db.Uuid
  aIngredientId String?          @map("a_ingredient_id") @db.Uuid
  aGroupId      String?          @map("a_group_id") @db.Uuid
  bIngredientId String?          @map("b_ingredient_id") @db.Uuid
  bGroupId      String?          @map("b_group_id") @db.Uuid
  reason        String           @db.VarChar(500)
  /// Where the claim comes from.
  source        String?          @db.VarChar(500)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  aIngredient   Ingredient?      @relation("RuleIngredientA", fields: [aIngredientId], references: [id], onDelete: Cascade)
  aGroup        IngredientGroup? @relation("RuleGroupA", fields: [aGroupId], references: [id], onDelete: Cascade)
  bIngredient   Ingredient?      @relation("RuleIngredientB", fields: [bIngredientId], references: [id], onDelete: Cascade)
  bGroup        IngredientGroup? @relation("RuleGroupB", fields: [bGroupId], references: [id], onDelete: Cascade)

  @@index([aIngredientId])
  @@index([aGroupId])
  @@index([bIngredientId])
  @@index([bGroupId])
  @@map("incompatibility_rules")
}

model Recipe {
  id          String             @id @default(uuid()) @db.Uuid
  /// The video post an admin wrote this recipe from.
  postId      String?            @map("post_id") @db.Uuid
  createdById String?            @map("created_by_id") @db.Uuid
  title       String             @db.VarChar(150)
  description String?            @db.VarChar(1000)
  /// A photo of the dish, hot-linked from another site; nothing is stored here.
  imageUrl    String?            @map("image_url") @db.VarChar(2048)
  servings    Int
  prepMinutes Int?               @map("prep_minutes")
  cookMinutes Int?               @map("cook_minutes")
  steps       String[]
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  post        Post?              @relation(fields: [postId], references: [id], onDelete: SetNull)
  createdBy   User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  ingredients RecipeIngredient[]
  mealPlans   MealPlanEntry[]
  blogs       BlogRecipe[]
  favorites   RecipeFavorite[]

  @@index([postId])
  @@map("recipes")
}

model RecipeIngredient {
  recipeId     String     @map("recipe_id") @db.Uuid
  ingredientId String     @map("ingredient_id") @db.Uuid
  position     Int
  quantity     Decimal?   @db.Decimal(8, 2)
  unit         String?    @db.VarChar(30)
  note         String?    @db.VarChar(200)
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([recipeId, ingredientId])
  @@index([ingredientId])
  @@map("recipe_ingredients")
}

/// Private saved recipes, independent of post bookmarks.
model RecipeFavorite {
  recipeId  String   @map("recipe_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([recipeId, userId])
  @@index([userId, createdAt, recipeId])
  @@map("recipe_favorites")
}

/// An ingredient a user does not eat (allergy, religion, dislike). Private to the user.
model UserAvoidedIngredient {
  userId       String     @map("user_id") @db.Uuid
  ingredientId String     @map("ingredient_id") @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([userId, ingredientId])
  @@index([ingredientId])
  @@map("user_avoided_ingredients")
}

/// A whole ingredient group a user does not eat, e.g. dairy.
model UserAvoidedGroup {
  userId  String          @map("user_id") @db.Uuid
  groupId String          @map("group_id") @db.Uuid
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   IngredientGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@index([groupId])
  @@map("user_avoided_groups")
}

/// An ingredient a user likes. A taste that steers suggestions, never a rule. Private to the user.
model UserLikedIngredient {
  userId       String     @map("user_id") @db.Uuid
  ingredientId String     @map("ingredient_id") @db.Uuid
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([userId, ingredientId])
  @@index([ingredientId])
  @@map("user_liked_ingredients")
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

/// Where a dish sits in a day. `OTHER` holds everything outside the three meals.
enum MealSection {
  BREAKFAST
  LUNCH
  DINNER
  OTHER
}

/// One dish in one section of one day of a user's weekly timetable. The week repeats: no dates.
model MealPlanEntry {
  userId   String      @map("user_id") @db.Uuid
  day      Weekday
  section  MealSection
  recipeId String      @map("recipe_id") @db.Uuid
  /// Order within the section.
  position Int
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe   Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([userId, day, section, recipeId])
  @@index([recipeId])
  @@map("meal_plan_entries")
}
