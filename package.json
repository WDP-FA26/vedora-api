{
  "name": "vedora-api",
  "version": "0.1.0",
  "description": "Vedora backend API built with NestJS, Prisma and MongoDB",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.mts",
    "test:db": "vitest run --config ./vitest.config.db.mts",
    "redteam": "node scripts/redteam.mts",
    "seed": "tsx src/database/seed-cli.ts",
    "seed:prod": "node dist/database/seed-cli.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@nestjs/common": "^11.2.5",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.5",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^11.2.5",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@qdrant/js-client-rest": "^1.19.0",
    "ai": "^7.0.118",
    "bcryptjs": "^3.0.3",
    "chunkdown": "^3.5.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.11.0",
    "dotenv": "^17.2.2",
    "ffmpeg-static": "^5.3.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.1.0",
    "mongodb": "7.7.0",
    "mongoose": "^9.11.4",
    "mupdf": "^1.28.1",
    "redis": "^6.3.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.28.1",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.6",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "supertest": "^7.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.44.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.1",
    "vitest-mock-extended": "^5.1.1"
  },
  "engines": {
    "node": ">=24.11"
  },
  "overrides": {
    "multer": "^2.3.0"
  }
}
